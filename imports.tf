# Uncomment a block, fill in the numeric ID, then see the Import section in README.md.
#
# Include the `provider` argument while Terraform generates the resource block
# for you. Remove it once you paste the generated block into your configuration.
# Terraform rejects the argument on an import block whose target already has
# a resource block.

# import {
#   provider = jamfplatform
#   to       = jamfplatform_pro_category.finance
#   id       = ""
# }

